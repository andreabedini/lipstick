cabal-version:   3.16
name:            lipstick
version:         0.1.0.0
synopsis:        Style definitions for nice terminal layouts
category:        Console, Text
description:
  A Haskell take on charmbracelet's lipgloss: styled, laid-out text for
  command-line output. Styles are built from composable modifiers and render
  to structured blocks, which are serialised to ANSI only at the edge.
license:         MIT
license-file:    LICENSE
author:          Andrea Bedini
maintainer:      andrea@bedini.au
homepage:        https://github.com/andreabedini/lipstick
bug-reports:     https://github.com/andreabedini/lipstick/issues
build-type:      Simple
extra-doc-files:
    CHANGELOG.md
    README.md
extra-source-files:
    scripts/GenUnicodeTable.hs
    test/data/GraphemeBreakTest.txt

source-repository head
    type:     git
    location: https://github.com/andreabedini/lipstick.git

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        Lipstick
        Lipstick.Ansi
        Lipstick.Block
        Lipstick.Border
        Lipstick.Color
        Lipstick.Layer
        Lipstick.Mod
        Lipstick.Place
        Lipstick.Style
        Lipstick.Table
        Lipstick.Outline
        Lipstick.Terminal
        Lipstick.Width
        Lipstick.Internal.Block
        Lipstick.Internal.Types
        Lipstick.Internal.UnicodeTable
    build-depends:
        base ^>=4.21.0.0,
        array ^>=0.5,
        bytestring >=0.11 && <0.13,
        text >=2.1.2 && <2.2,
        ansi-terminal ^>=1.1,
        colour ^>=2.3,
        containers >=0.6 && <0.8
    default-language: GHC2024

executable lipstick-demo
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   examples
    build-depends:
        base,
        text,
        lipstick
    default-language: GHC2024

executable lipstick-screenshots
    import:           warnings
    main-is:          Screenshots.hs
    other-modules:    Svg
    hs-source-dirs:   examples
    build-depends:
        base,
        filepath,
        text,
        lipstick
    default-language: GHC2024

test-suite lipstick-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:
        base,
        text,
        lipstick,
        directory,
        tasty ^>=1.5,
        tasty-hunit ^>=0.10,
        tasty-quickcheck ^>=0.11,
        QuickCheck >=2.14 && <2.20
    default-language: GHC2024
