cabal-version:   3.12
name:            lipstick
version:         0.1.0.0
synopsis:        Style definitions for nice terminal layouts
category:        Console, Text
description:
  A Haskell take on charmbracelet's lipgloss: styled, laid-out text for
  command-line output. Styles are built from composable modifiers and render
  to structured blocks, which are serialised to ANSI only at the edge.
license:         MIT AND Unicode-3.0
license-files:
    LICENSE
    LICENSE.Unicode
author:          Andrea Bedini
maintainer:      andrea@bedini.au
homepage:        https://github.com/andreabedini/lipstick
bug-reports:     https://github.com/andreabedini/lipstick/issues
build-type:      Simple
extra-doc-files:
    CHANGELOG.md
    README.md
extra-source-files:
    scripts/GenUnicodeTable.hs
    test/data/GraphemeBreakTest.txt

source-repository head
    type:     git
    location: https://github.com/andreabedini/lipstick.git

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import:           warnings
    -- The public modules are in src; the representation of blocks, grids,
    -- styles and colours is in internal, as other-modules, so other
    -- packages cannot import it.
    hs-source-dirs:   src internal
    exposed-modules:
        Lipstick
        Lipstick.Ansi
        Lipstick.Block
        Lipstick.Border
        Lipstick.Color
        Lipstick.Grid
        Lipstick.Layer
        Lipstick.Mod
        Lipstick.Place
        Lipstick.Style
        Lipstick.Table
        Lipstick.Outline
        Lipstick.Terminal
        Lipstick.Width
    other-modules:
        Lipstick.Internal.Border
        Lipstick.Internal.Color
        Lipstick.Internal.Grid
        Lipstick.Internal.Layout
        Lipstick.Internal.Mod
        Lipstick.Internal.Types
        Lipstick.Internal.UnicodeTable
        Lipstick.Internal.Width
    build-depends:
        base >=4.20 && <4.23,
        array ^>=0.5,
        bytestring >=0.11 && <0.13,
        text >=2.1.2 && <2.2,
        ansi-terminal ^>=1.1,
        terminal-size >=0.3.4 && <0.4,
        colour ^>=2.3,
        containers >=0.6 && <0.9
    default-language: GHC2024

executable lipstick-demo
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   examples
    build-depends:
        base,
        text,
        lipstick
    default-language: GHC2024

executable lipstick-screenshots
    import:           warnings
    main-is:          Screenshots.hs
    other-modules:    Svg
    hs-source-dirs:   examples
    build-depends:
        base,
        filepath ^>=1.5,
        text,
        lipstick
    default-language: GHC2024

test-suite lipstick-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    -- The tests reach the library's internals by compiling its sources.
    hs-source-dirs:   test src internal
    other-modules:
        Lipstick
        Lipstick.Ansi
        Lipstick.Block
        Lipstick.Border
        Lipstick.Color
        Lipstick.Grid
        Lipstick.Layer
        Lipstick.Mod
        Lipstick.Place
        Lipstick.Style
        Lipstick.Table
        Lipstick.Outline
        Lipstick.Terminal
        Lipstick.Width
        Lipstick.Internal.Border
        Lipstick.Internal.Color
        Lipstick.Internal.Grid
        Lipstick.Internal.Layout
        Lipstick.Internal.Mod
        Lipstick.Internal.Types
        Lipstick.Internal.UnicodeTable
        Lipstick.Internal.Width
    build-depends:
        base >=4.20 && <4.23,
        array ^>=0.5,
        bytestring >=0.11 && <0.13,
        text >=2.1.2 && <2.2,
        ansi-terminal ^>=1.1,
        terminal-size >=0.3.4 && <0.4,
        colour ^>=2.3,
        containers >=0.6 && <0.9,
        directory,
        tasty ^>=1.5,
        tasty-hunit ^>=0.10,
        tasty-quickcheck ^>=0.11,
        QuickCheck >=2.14 && <2.20
    default-language: GHC2024
