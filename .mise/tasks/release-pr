#!/usr/bin/env zsh
#MISE description="Open a release PR: bump the package versions and add the release to the changelogs"
setopt err_exit no_unset pipe_fail

# git-cliff reads release tags from git. jj does not need them, so fetch them with git.
git fetch --tags --quiet origin
jj git fetch

# The task makes the release change on top of main, then comes back to the
# change it started from, however it ends. A starting change that was empty
# is abandoned when the task moves away from it, so it comes back to its
# parents instead. A release change that was not pushed is abandoned.
start=$(jj log --no-graph -r @ -T change_id)
start_parents=( ${(f)"$(jj log --no-graph -r 'parents(@)' -T 'change_id ++ "\n"')"} )
# In a colocated repo, git HEAD is now main@origin, so git-cliff reads the
# history of main and not of the current work.
jj new 'main@origin'
release=$(jj log --no-graph -r @ -T change_id)
pushed=false
TRAPEXIT() {
  # Every subshell, such as a command substitution, runs EXIT traps too.
  (( ZSH_SUBSHELL == 0 )) || return 0
  setopt local_options no_err_exit
  $pushed || jj abandon --quiet $release
  if jj log --quiet --no-graph -r "present($start)" -T change_id | grep -q .; then
    jj edit --quiet $start
  else
    jj new --quiet $start_parents
  fi
}

fail() {
  print -u2 "error: $1"
  exit 1
}

# Commits that cliff.toml skips are not in the context.
releasable=$(git cliff --unreleased --context | jq '(.[0].commits // []) | length')
if (( releasable == 0 )); then
  print "No releasable commits since the last release."
  exit 0
fi

# git-cliff bumps the last three components of the latest tag, or takes
# [bump] initial_tag from cliff.toml if there is no tag yet.
next=$(git cliff --bumped-version)
next=${next#v}
[[ $next == <->.<->.<->.<-> ]] || fail "next version $next is not A.B.C.D"

# Every package in cabal.project has the version of the release. cabal sdist
# names each tarball NAME-VERSION.tar.gz, and --list-only lists the files of
# every package, its .cabal file among them.
sdist=$(mktemp -d)
cabal sdist all -o $sdist >/dev/null
files=( ${(f)"$(cabal sdist all --list-only)"} )
cabals=()
for tarball in $sdist/*.tar.gz; do
  name=${${tarball:t}%-*}
  matches=( ${(M)files:#(*/|)$name.cabal} )
  (( $#matches == 1 )) || fail "cannot tell which file is $name.cabal: ${(j:, :)matches}"
  cabals+=( ${matches[1]#./} )
done
rm -rf $sdist
(( $#cabals > 0 )) || fail "cabal sdist found no packages"

# sed writes a new file: sed -i differs between GNU and BSD sed.
for cabal in $cabals; do
  sed -E "s/^(version:[[:space:]]+).*/\1$next/" $cabal > $cabal.new
  mv $cabal.new $cabal
done

# A package that depends on another package of the project requires the
# version of this release, as `NAME ^>=VERSION`. Otherwise, after a major
# bump, the solver would skip the local package and look for the old version
# on Hackage. Only ^>= bounds are rewritten.
names=( ${${cabals:t}%.cabal} )
for cabal in $cabals; do
  for name in $names; do
    sed -E "s/(^|[[:space:],])(${name}[[:space:]]+\^>=[[:space:]]*)[0-9.]+/\1\2$next/" $cabal > $cabal.new
    mv $cabal.new $cabal
  done
done

# Every package has a CHANGELOG.md next to its .cabal file. The one at the
# top lists every commit, and the release notes come from it; the one of a
# package in a subdirectory lists the commits that change that subdirectory.
# The task puts the section of the release above the previous one and keeps
# the rest of the file. A section for the release that is already there, for
# example written by hand for the first release, is kept with today's date.
export VERSION=$next TODAY=$(date +%Y-%m-%d)
for cabal in $cabals; do
  dir=${cabal:h}
  changelog=$dir/CHANGELOG.md
  [[ -f $changelog ]] || fail "$changelog does not exist"
  paths=()
  [[ $dir == . ]] || paths=( --include-path "$dir/**" )
  SECTION=$(git cliff --unreleased --tag "v$next" --strip all $paths)
  [[ $SECTION == *$'\n### '* ]] ||
    SECTION+=$'\n\nNo changes other than the versions of the packages it depends on.'
  export SECTION
  awk '
    BEGIN { head = "## [" ENVIRON["VERSION"] "]" }
    !done && index($0, head) == 1 { print head " - " ENVIRON["TODAY"]; done = 1; next }
    !done && /^## / { print ENVIRON["SECTION"]; print ""; done = 1 }
    { print }
    END { if (!done) { print ""; print ENVIRON["SECTION"] } }
  ' $changelog > $changelog.new
  mv $changelog.new $changelog
done

# When the task runs again for the same version, for example after main
# moved on, it replaces the branch and the commit of the open release PR,
# and abandons the old commit if nothing was built on it.
jj describe -m "chore(release): $next"
old=$(jj log --no-graph -r "present(release-$next)" -T change_id)
jj bookmark set "release-$next" -r @ --allow-backwards
jj git push -b "release-$next"
pushed=true
if [[ -n $old && $old != $release ]] && jj log --no-graph -r "$old & heads(all())" -T change_id | grep -q .; then
  jj abandon --quiet $old
fi
if [[ $(gh pr view "release-$next" --json state --jq .state 2>/dev/null) == OPEN ]]; then
  print "Release PR for $next is updated."
else
  gh pr create --head "release-$next" --title "chore(release): $next" \
    --body-file =(awk -v v="$next" '/^## /{p = index($0, "[" v "]") > 0; next} p' CHANGELOG.md)
  print "Release PR for $next is open."
fi
