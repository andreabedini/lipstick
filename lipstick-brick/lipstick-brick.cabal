cabal-version:   3.16
name:            lipstick-brick
version:         0.1.0.0
synopsis:        Show lipstick blocks in brick and vty applications
description:
  Turn lipstick blocks into vty images and brick widgets, so styles, tables,
  lists and trees made with lipstick can be shown in terminal user interfaces.
category:        Console, User Interfaces
license:         MIT
license-file:    LICENSE
author:          Andrea Bedini
maintainer:      andrea@bedini.au
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Lipstick.Brick
    build-depends:
        base ^>=4.21.0.0,
        text ^>=2.1,
        lipstick ^>=0.1,
        vty >=6.2 && <6.5,
        brick >=2.7 && <2.11
    default-language: GHC2024

test-suite lipstick-brick-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:
        base,
        lipstick,
        lipstick-brick,
        vty,
        tasty ^>=1.5,
        tasty-hunit ^>=0.10
    default-language: GHC2024
